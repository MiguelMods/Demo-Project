@model List<GoalResponse>
<!-- Page header -->
<div class="page-header">
    <div class="page-header-left">
        <h1 class="page-title">Proyectos</h1>
        <p class="page-subtitle">Gestión y Seguimiento de Objetivos Registrados</p>
    </div>
    <div class="page-header-actions">
        <a href="#" class="btn-ghost-custom">
            <i class="bi bi-printer" style="font-size:14px;"></i>
            Imprimir
        </a>
        <a href="/goal/register" class="btn-primary-custom">
            <i class="bi bi-plus" style="font-size:16px;"></i>
            Nuevo Objetivo
        </a>
    </div>
</div>

<!-- Toolbar -->
<div class="table-toolbar">
    <div class="search-wrap">
        <i class="bi bi-search search-icon"></i>
        <input type="text"
               class="search-input"
               id="tableSearch"
               placeholder="Buscar Objetivo..."
               oninput="filterTable()" />
    </div>
    <span class="table-count" id="tableCount">@Model.Count Objetivo@(Model.Count != 1 ? "s" : "")</span>
</div>

<!-- Table -->
<div class="table-card">
    <table class="data-table" id="projectTable">
        <thead>
            <tr>
                <th>#</th>
                <th>Código</th>
                <th>Tipo de Objetivo</th>
                <th>Nombre</th>
                <th>Projecto</th>
                <th>Area</th>
                <th>Descripción</th>
                <th>Fecha entrega</th>
                <th>Creado por</th>
                <th>Estado</th>
                <th>Detalle</th>
            </tr>
        </thead>
        <tbody id="tableBody">
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="9">
                        <div class="table-empty">
                            <div class="table-empty-icon"><i class="bi bi-kanban"></i></div>
                            <div class="table-empty-title">Sin Objetivos registrados</div>
                            <div class="table-empty-desc">Crea el primer objetivo usando el botón "Nuevo Objetivo"</div>
                        </div>
                    </td>
                </tr>
            }
            else
            {
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="cell-id" data-label="#">@item.GoalId</td>
                        <td data-label="Código">
                            <span class="cell-code">@item.Code</span>
                        </td>
                        <td data-label="Tipo de Objetivo">
                            <span class="cell-name" title="@item.GoalType">@item.GoalType</span>
                        </td>
                        <td data-label="Nombre">
                            <span class="cell-name" title="@item.Name">@item.Name</span>
                        </td>
                        <td data-label="Projecto">
                            <span class="cell-name" title="@item.Project.Name">@item.Project.Name</span>
                        </td>
                        <td data-label="Area">
                            <span class="cell-name" title="@item.Area">@item.Area</span>
                        </td>
                        <td data-label="Descripción">
                            <span class="cell-desc" title="@item.Description">@item.Description</span>
                        </td>
                        <td data-label="Fecha entrega">
                            <span class="cell-desc" title="@item.CreatedAt">@item.CreatedAt</span>
                        </td>
                        <td data-label="Creado por">
                            <div class="cell-user">
                                <div class="user-avatar">
                                    @(item.CreatedBy.Trim().Substring(0, 1).ToUpper())
                                </div>
                                <span class="cell-user-name">@item.CreatedBy</span>
                            </div>
                        </td>
                        <td data-label="Estado">
                            <span class="badge-active @(item.IsActive ? "yes" : "no")">
                                <span class="badge-dot"></span>
                                @(item.IsActive ? "Activo" : "Inactivo")
                            </span>
                        </td>
                        <td data-label="Acciones">
                            <a asp-action="detail" asp-route-rowguid="@item.RowGuid" class="btn-detail">
                                <i class="bi bi-eye" style="font-size:12px;"></i>
                                Detalle
                            </a>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>
<partial name="_viewBagErrorHtml" />
<script>
    function filterTable()
    {
        const q = document.getElementById('tableSearch').value.toLowerCase();
        const rows = document.querySelectorAll('#tableBody tr');
        let visible = 0;
        rows.forEach(row =>
        {
            const text = row.textContent.toLowerCase();
            const show = text.includes(q);
            row.style.display = show ? '' : 'none';
            if (show) visible++;
        });
        document.getElementById('tableCount').textContent =
            visible + ' Objetivo' + (visible !== 1 ? 's' : '');
    }
</script>
