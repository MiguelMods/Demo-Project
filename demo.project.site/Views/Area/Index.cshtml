@model List<AreaResponse>

<div class="p-3">
    <div class="row">
        <div class="col-12 mb-3">
            <div class="d-flex justify-content-lg-between">
                <h4>Mantenimiento de Proyectos</h4>
                <div class="d-flex gap-3">
                    <a asp-action="register" asp-controller="area" class="btn btn-primary">Registrar</a>
                    <a href="#" class="btn btn-secondary">Imprimir</a>
                </div>
            </div>
        </div>
        <div class="col-12">
            <table class="table table-hover table-bordered">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Codigo</th>
                        <th>Name</th>
                        <th>Descripcion</th>
                        <th>Estatus</th>
                        <th>Accion</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach(var item in Model)
                    {
                        <tr>
                            <td>@item.AreaId</td>
                            <td>@item.Code</td>
                            <td>@item.Name</td>
                            <td>@item.Description</td>
                            <td>@(item.IsActive ? "Activo" : "Inactivo")</td>
                            <td><a asp-action="detail" asp-controller="area" asp-route-rowguid="@item.RowGuid" class="btn btn-success">Detalle</a></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>