@model List<ProjectResponse>

<!-- Page header -->
<div class="page-header">
    <div class="page-header-left">
        <h1 class="page-title">Proyectos</h1>
        <p class="page-subtitle">Gestión y seguimiento de proyectos registrados</p>
    </div>
    <div class="page-header-actions">
        <a href="#" class="btn-ghost-custom">
            <i class="bi bi-printer" style="font-size:14px;"></i>
            Imprimir
        </a>
        <a href="/project/register" class="btn-primary-custom">
            <i class="bi bi-plus" style="font-size:16px;"></i>
            Nuevo proyecto
        </a>
    </div>
</div>

<!-- Toolbar -->
<div class="table-toolbar">
    <div class="search-wrap">
        <i class="bi bi-search search-icon"></i>
        <input type="text"
               class="search-input"
               id="tableSearch"
               placeholder="Buscar proyecto..."
               oninput="filterTable()" />
    </div>
    <span class="table-count" id="tableCount">@Model.Count proyecto@(Model.Count != 1 ? "s" : "")</span>
</div>

<!-- Table -->
<div class="table-card">
    <table class="data-table" id="projectTable">
        <thead>
            <tr>
                <th>#</th>
                <th>Código</th>
                <th>Nombre</th>
                <th>Descripción</th>
                <th>Fecha entrega</th>
                <th>Creado por</th>
                <th>Área</th>
                <th>Estado</th>
                <th></th>
            </tr>
        </thead>
        <tbody id="tableBody">
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="9">
                        <div class="table-empty">
                            <div class="table-empty-icon"><i class="bi bi-kanban"></i></div>
                            <div class="table-empty-title">Sin proyectos registrados</div>
                            <div class="table-empty-desc">Crea el primer proyecto usando el botón "Nuevo proyecto"</div>
                        </div>
                    </td>
                </tr>
            }
            else
            {
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="cell-id" data-label="#">@item.ProjectId</td>
                        <td data-label="Código">
                            <span class="cell-code">@item.CodeOne</span>
                        </td>
                        <td data-label="Nombre">
                            <span class="cell-name" title="@item.Name">@item.Name</span>
                        </td>
                        <td data-label="Descripción">
                            <span class="cell-desc" title="@item.Description">@item.Description</span>
                        </td>
                        <td data-label="Fecha entrega" class="cell-date">
                            <i class="bi bi-calendar3" style="font-size:12px; color:#c4c4c7; margin-right:5px;"></i>
                            @item.WishDate?.ToString("dd MMM yyyy")
                        </td>
                        <td data-label="Creado por">
                            <div class="cell-user">
                                @*                                 <div class="user-avatar">
                                    @(item.CreatedBy)
                                </div> *@
                                <span class="cell-user-name">@item.CreatedBy</span>
                            </div>
                        </td>
                        <td data-label="Área" style="color:#52525b; font-size:13px;">@item.Area</td>
                        <td data-label="Estado">
                            <span class="badge-active @(item.IsActive ? "yes" : "no")">
                                <span class="badge-dot"></span>
                                @(item.IsActive ? "Activo" : "Inactivo")
                            </span>
                        </td>
                        <td data-label="Acciones" style="text-align:right;">
                            <a asp-action="detail" asp-route-rowguid="@item.RowGuid" class="btn-detail">
                                <i class="bi bi-eye" style="font-size:12px;"></i>
                                Detalle
                            </a>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

<script>
    function filterTable() {
        const q = document.getElementById('tableSearch').value.toLowerCase();
        const rows = document.querySelectorAll('#tableBody tr');
        let visible = 0;
        rows.forEach(row => {
            const text = row.textContent.toLowerCase();
            const show = text.includes(q);
            row.style.display = show ? '' : 'none';
            if (show) visible++;
        });
        document.getElementById('tableCount').textContent =
            visible + ' proyecto' + (visible !== 1 ? 's' : '');
    }
</script>
