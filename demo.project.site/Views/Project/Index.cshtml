@model List<ProjectResponse>

<div class="p-3">
    <div class="row">
        <div class="col-12 mb-3">
            <div class="d-flex justify-content-lg-between">
                <h4>Mantenimiento de Proyectos</h4>
                <div class="d-flex gap-3">
                    <a href="/project/register" class="btn btn-primary">Registrar</a>
                    <a href="#" class="btn btn-secondary">Imprimir</a>
                </div>
            </div>
        </div>
        <div class="col-12">
            <table class="table table-hover table-bordered">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Codigo</th>
                        <th>Nombre</th>
                        <th>Descripcion</th>
                        <th>Fecha de Entrega</th>
                        <th>Creado Por</th>
                        <th>Area</th>
                        <th>Activo</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.ProjectId</td>
                            <td>@item.CodeOne</td>
                            <td>@item.Name</td>
                            <td>@item.Description</td>
                            <td>@item.WishDate</td>
                            <td>@item.CreatedBy</td>
                            <td>@item.Area</td>
                            <td>@(item.IsActive ? "Si" : "No")</td>
                            <td class="text-center"><a asp-action="detail" asp-route-rowguid="@item.RowGuid" class="btn btn-primary">Detalle</a></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>