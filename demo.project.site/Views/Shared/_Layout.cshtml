<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Demo</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/notify.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/async-select.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/demo.project.site.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
</head>
<body>
    <!-- Loading banner -->
    <div id="page-loading-banner" style="
    display: none;
    position: fixed;
    top: 0; left: 0; right: 0;
    height: 3px;
    z-index: 9998;
    background: #27272a;
    overflow: hidden;
">
        <div id="page-loading-bar" style="
        height: 100%;
        width: 0%;
        background: #6366f1;
        border-radius: 0 2px 2px 0;
        transition: width 0.1s ease;
        box-shadow: 0 0 8px rgba(99,102,241,0.6);
    "></div>
    </div>

    <div id="page-loading-toast" style="
    display: none;
    position: fixed;
    bottom: 24px; right: 24px;
    z-index: 9997;
    background: #16181f;
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 12px;
    padding: 12px 16px;
    display: none;
    align-items: center;
    gap: 10px;
    font-size: 13px;
    color: #a1a1aa;
    box-shadow: 0 8px 24px rgba(0,0,0,0.25);
    pointer-events: none;
">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none"
             style="flex-shrink:0; animation: spin 0.8s linear infinite;">
            <circle cx="12" cy="12" r="10" stroke="#3f3f46" stroke-width="2.5" />
            <path d="M12 2a10 10 0 0 1 10 10" stroke="#818cf8" stroke-width="2.5"
                  stroke-linecap="round" />
        </svg>
        <span>Cargando contenido...</span>
    </div>

    <style>
        @@keyframes spin {
            to {
                transform: rotate(360deg);
            }
        }
    </style>

    <script>
        const loadingBar = document.getElementById('page-loading-bar');
        const loadingBanner = document.getElementById('page-loading-banner');
        const loadingToast = document.getElementById('page-loading-toast');

        let barInterval = null;
        let toastTimeout = null;

        function startLoading()
        {
            // Barra superior
            loadingBanner.style.display = 'block';
            loadingBar.style.width = '0%';

            let progress = 0;
            clearInterval(barInterval);
            barInterval = setInterval(() =>
            {
                // avanza rápido al inicio, se frena al llegar a 85%
                const step = progress < 40 ? 8 : progress < 70 ? 4 : progress < 85 ? 1 : 0;
                progress = Math.min(progress + step, 85);
                loadingBar.style.width = progress + '%';
            }, 80);

            // Toast aparece solo si tarda más de 300ms (evita flash en páginas rápidas)
            toastTimeout = setTimeout(() =>
            {
                loadingToast.style.display = 'flex';
            }, 300);
        }

        function stopLoading()
        {
            clearInterval(barInterval);
            clearTimeout(toastTimeout);

            // completa la barra antes de ocultarla
            loadingBar.style.transition = 'width 0.2s ease';
            loadingBar.style.width = '100%';

            setTimeout(() =>
            {
                loadingBanner.style.display = 'none';
                loadingBar.style.width = '0%';
                loadingBar.style.transition = 'width 0.1s ease';
                loadingToast.style.display = 'none';

            }, 250);
            setTimeout(() =>
            {
                notify.banner.success("Pagina Cargada");
            }, 250);
        }

        // Disparar en cualquier clic sobre <a> que navegue a otra URL
        document.addEventListener('click', e =>
        {
            const anchor = e.target.closest('a');
            if (!anchor) return;

            const href = anchor.getAttribute('href');
            if (!href) return;

            // ignorar: anclas, javascript:, target="_blank", mismo hash
            if (
                href.startsWith('#') ||
                href.startsWith('javascript') ||
                anchor.target === '_blank' ||
                anchor.hasAttribute('data-no-loading')
            ) return;

            startLoading();
        });

        // Detener cuando la página ya cargó (por si se llega directo)
        window.addEventListener('pageshow', stopLoading);
    </script>
    <!-- ── TOPBAR ──────────────────────────────── -->
    <header class="topbar">
        <button class="topbar-toggle" id="sidebarToggle" title="Toggle sidebar">
            <i class="bi bi-layout-sidebar"></i>
        </button>
        <a class="topbar-brand" asp-area="" asp-controller="Home" asp-action="Index">
            <span class="topbar-brand-dot"></span>
            Demo App
        </a>
        <div class="topbar-right">
            <div class="topbar-user" title="@User.Identity?.Name">
                @(User.Identity?.Name?.Substring(0, 1).ToUpper() ?? "U")
            </div>
        </div>
    </header>

    <div class="app-wrapper">

        <!-- ── SIDEBAR ─────────────────────────── -->
        <nav class="sidebar" id="sidebar">
            <div class="sidebar-nav">

                <!-- GENERAL -->
                <div class="nav-section-label">General</div>

                <div class="nav-item-wrapper">
                    <a class="nav-link-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "active" : "")"
                       asp-controller="Home" asp-action="Index">
                        <i class="bi bi-house nav-icon"></i>
                        <span class="nav-label">Inicio</span>
                    </a>
                    <span class="nav-tooltip">Inicio</span>
                </div>

                <!-- GESTIÓN (with submenu) -->
                <div class="nav-section-label">Gestión</div>

                <div class="nav-item-wrapper">
                    <div class="nav-link-item @(ViewContext.RouteData.Values["controller"]?.ToString() is "Project" or "Initiative" or "Goal" ? "active open" : "")"
                         onclick="toggleSubmenu('submenu-projects', this)">
                        <i class="bi bi-kanban nav-icon"></i>
                        <span class="nav-label">Proyectos</span>
                        <i class="bi bi-chevron-down nav-chevron"></i>
                    </div>
                    <span class="nav-tooltip">Proyectos</span>
                    <div class="submenu @(ViewContext.RouteData.Values["controller"]?.ToString() is "Project" or "Initiative" or "Goal" ? "open" : "")"
                         id="submenu-projects">
                        <a class="submenu-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Project" ? "active" : "")"
                           asp-controller="Project" asp-action="Index">
                            <span class="submenu-dot"></span> Todos los proyectos
                        </a>
                        <a class="submenu-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Goal" ? "active" : "")"
                           asp-controller="Goal" asp-action="Index">
                            <span class="submenu-dot"></span> Todos los Objetivos
                        </a>
                        <a class="submenu-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Initiative" ? "active" : "")"
                           asp-controller="Initiative" asp-action="Index">
                            <span class="submenu-dot"></span> Todas las Iniciativas
                        </a>
                    </div>
                </div>

                <div class="nav-item-wrapper">
                    <a class="nav-link-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Area" ? "active" : "")"
                       asp-controller="Area" asp-action="Index">
                        <i class="bi bi-diagram-3 nav-icon"></i>
                        <span class="nav-label">Áreas</span>
                    </a>
                    <span class="nav-tooltip">Áreas</span>
                </div>

                <!-- CONFIGURACIÓN -->
                <div class="nav-section-label">Configuración</div>

                <div class="nav-item-wrapper">
                    <div class="nav-link-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "User" ? "active open" : "")"
                         onclick="toggleSubmenu('submenu-settings', this)">
                        <i class="bi bi-gear nav-icon"></i>
                        <span class="nav-label">Configuración</span>
                        <i class="bi bi-chevron-down nav-chevron"></i>
                    </div>
                    <span class="nav-tooltip">Configuración</span>
                    <div class="submenu @(ViewContext.RouteData.Values["controller"]?.ToString() == "User" ? "open" : "")"
                         id="submenu-settings">
                        <a class="submenu-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "User" ? "active" : "")"
                           asp-controller="User" asp-action="Index">
                            <span class="submenu-dot"></span> Usuarios
                        </a>
                    </div>
                </div>

            </div>

            <!-- SIDEBAR FOOTER -->
            <div class="sidebar-footer">
                <div class="sidebar-user">
                    <div class="sidebar-avatar">
                        @(User.Identity?.Name?.Substring(0, 1).ToUpper() ?? "U")
                    </div>
                    <div class="sidebar-user-info">
                        <div class="sidebar-user-name">@(User.Identity?.Name ?? "Usuario")</div>
                        <div class="sidebar-user-role">Administrador</div>
                    </div>
                </div>
            </div>
        </nav>

        <!-- ── MAIN ────────────────────────────── -->
        <div class="main-content" id="mainContent">
            <main class="page-content">
                @RenderBody()
            </main>

            <footer class="app-footer">
                &copy; @DateTime.Now.Year Demo App &mdash;
                <a asp-area="" asp-controller="Home" asp-action="Privacy"
                   style="color: inherit; text-decoration: underline;">Privacidad</a>
            </footer>
        </div>

    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/notify.js" asp-append-version="true"></script>
    <script src="~/js/async-select.js" asp-append-version="true"></script>
    <script>
        const sidebar = document.getElementById('sidebar');
        const toggleBtn = document.getElementById('sidebarToggle');
        const COLLAPSED_KEY = 'sidebar_collapsed';

        // Restore state
        if (localStorage.getItem(COLLAPSED_KEY) === '1')
        {
            sidebar.classList.add('collapsed');
        }
        toggleBtn.addEventListener('click', () =>
        {
            const isMobile = window.innerWidth <= 768;
            if (isMobile)
            {
                sidebar.classList.toggle('mobile-open');
            } else
            {
                sidebar.classList.toggle('collapsed');
                localStorage.setItem(COLLAPSED_KEY, sidebar.classList.contains('collapsed') ? '1' : '0');
            }
        });

        function toggleSubmenu(id, trigger)
        {
            if (sidebar.classList.contains('collapsed')) return;
            const menu = document.getElementById(id);
            const isOpen = menu.classList.contains('open');
            menu.classList.toggle('open', !isOpen);
            trigger.classList.toggle('open', !isOpen);
        }
    </script>
    <partial name="_Notifications" />
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
