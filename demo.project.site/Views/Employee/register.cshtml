@model EmployeCreateViewModel

<div class="row justify-content-center">
    <div class="col-12 col-xl-10">

        <!-- Breadcrumb -->
        <nav style="margin-bottom: 1rem;">
            <ol style="display:flex; align-items:center; gap:6px; list-style:none; margin:0; padding:0; font-size:13px; color:#a1a1aa;">
                <li><a asp-controller="Home" asp-action="Index" style="color:#a1a1aa; text-decoration:none;">Inicio</a></li>
                <li style="color:#d4d4d8;">/</li>
                <li><a asp-controller="Employee" asp-action="Index" style="color:#a1a1aa; text-decoration:none;">Empleados</a></li>
                <li style="color:#d4d4d8;">/</li>
                <li style="color:#52525b; font-weight:500;">Nuevo Empleado</li>
            </ol>
        </nav>

        <div class="form-card">

            <!-- Header -->
            <div class="form-card-header">
                <div class="form-card-header-left">
                    <div class="form-card-icon">
                        <i class="bi bi-kanban"></i>
                    </div>
                    <div>
                        <p class="form-card-title">Nuevo Empleado</p>
                        <p class="form-card-subtitle">Complete los campos para registrar un nuevo empleado</p>
                    </div>
                </div>
                <button type="reset" form="project-form" class="btn-ghost-custom">
                    <i class="bi bi-arrow-counterclockwise" style="font-size:14px;"></i>
                    Limpiar
                </button>
            </div>

            <!-- Body -->
            <div class="form-card-body">
                <form id="project-form" asp-action="post" method="POST">
                    @Html.AntiForgeryToken()
                    <input asp-for="EmployeeId" type="hidden" />
                    <div asp-validation-summary="All"></div>
                    <!-- IDENTIFICACIÓN -->
                    <div class="form-section">
                        <div class="form-section-title">Identificación</div>
                        <div class="form-grid">
                            <div class="field-group">
                                <label asp-for="Gender" class="field-label"></label>
                                <select asp-for="Gender" data-async-select data-url="/fill/options/genders" data-placeholder="Seleccione un genero" class="form-select-custom"></select>
                                <span asp-validation-for="Gender" class="field-error"></span>
                            </div>
                            <div class="field-group">
                                <label asp-for="Code" class="field-label"></label>
                                <input asp-for="Code" class="form-control-custom" placeholder="Código principal" />
                                <span asp-validation-for="Code" class="field-error"></span>
                            </div>
                            <div class="field-group">
                                <label asp-for="FirtName" class="field-label"></label>
                                <input asp-for="FirtName" class="form-control-custom" placeholder="Código secundario" />
                                <span asp-validation-for="FirtName" class="field-error"></span>
                            </div>
                            <div class="field-group">
                                <label asp-for="MiddleName" class="field-label"></label>
                                <input asp-for="MiddleName" class="form-control-custom" placeholder="Nombre del proyecto" />
                                <span asp-validation-for="MiddleName" class="field-error"></span>
                            </div>
                            <div class="field-group">
                                <label asp-for="Surname" class="field-label"></label>
                                <input asp-for="Surname" class="form-control-custom" placeholder="Objetivo principal" />
                                <span asp-validation-for="Surname" class="field-error"></span>
                            </div>
                            <div class="field-group">
                                <label asp-for="Photo" class="field-label"></label>
                                <input asp-for="Photo" class="form-control-custom" placeholder="Objetivo principal" />
                                <span asp-validation-for="Photo" class="field-error"></span>
                            </div>
                            <div class="field-group">
                                <label asp-for="AreaId" class="field-label"></label>
                                <select asp-for="AreaId" data-async-select data-url="/fill/options/areas" data-placeholder="Seleccione un área" class="form-select-custom"></select>
                                <span asp-validation-for="AreaId" class="field-error"></span>
                            </div>
                            <div class="field-group">
                                <label asp-for="PositionId" class="field-label"></label>
                                <select asp-for="PositionId" data-async-select data-url="/fill/options/positions" data-placeholder="Seleccione un posicion" class="form-select-custom"></select>
                                <span asp-validation-for="PositionId" class="field-error"></span>
                            </div>
                            <div class="field-group">
                                <label asp-for="SuperiorEmployeeId" class="field-label"></label>
                                <select asp-for="SuperiorEmployeeId" data-async-select data-url="/fill/options/employees" data-placeholder="Seleccione un empleados" class="form-select-custom"></select>
                                <span asp-validation-for="SuperiorEmployeeId" class="field-error"></span>
                            </div>
                        </div>
                    </div>

                    <!-- OPCIONES -->
                    <div class="form-section">
                        <div class="form-section-title">Opciones</div>
                        <div class="form-grid" style="gap: 10px;">
                            <label class="toggle-group" for="CreateUserSystem">
                                <div>
                                    <div class="toggle-label">@Html.DisplayNameFor(m => m.CreateUserSystem)</div>
                                    <div class="toggle-desc">Crear el usuario asociado a este empleado</div>
                                </div>
                                <label class="switch">
                                    <input asp-for="CreateUserSystem" type="checkbox" />
                                    <span class="switch-slider"></span>
                                </label>
                            </label>
                        </div>
                    </div>

                    <!-- ACTIONS -->
                    <div style="display:flex; justify-content:flex-end; gap:10px; padding-top: 1rem; border-top: 1px solid #f0f0f2;">
                        <a asp-action="Index" class="btn-ghost-custom">
                            <i class="bi bi-x" style="font-size:16px;"></i>
                            Cancelar
                        </a>
                        <button type="submit" class="btn-primary-custom">
                            <i class="bi bi-check2" style="font-size:16px;"></i>
                            Registrar Empleado
                        </button>
                    </div>

                </form>
            </div>
        </div>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
